{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "*.html,CSS/**,data/**,questions.json,style.css,nav-header.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/login",
      "destination": "/api/index.js"
    },
    {
      "source": "/register",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
